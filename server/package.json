{
  "name": "takeout-box-server",
  "version": "1.0.0",
  "description": "Backend API for The Takeout Box Restaurant Supply with MySQL and Firebase Auth",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/database/initDb.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:insert": "node insert_data.js"
  },
  "keywords": [
    "takeout-box",
    "restaurant-supply",
    "express",
    "mysql",
    "firebase"
  ],
  "author": "The Takeout Box Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.0.13",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
